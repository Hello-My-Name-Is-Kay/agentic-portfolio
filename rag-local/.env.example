# .env.example — Copy to .env and fill in your values.
# All settings have defaults; you only need to override what differs.

# --- Vector store ---
# RAG_CHROMA_PERSIST_DIR=./data/vectorstore
# RAG_COLLECTION_NAME=rental_policies

# --- Embedding model ---
# RAG_EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# RAG_EMBEDDING_DEVICE=cpu

# --- Chunking ---
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64

# --- Ollama LLM ---
# RAG_OLLAMA_BASE_URL=http://localhost:11434
# RAG_OLLAMA_MODEL=llama3.2
# RAG_LLM_TIMEOUT_S=60

# --- Generation ---
# RAG_MAX_NEW_TOKENS=512
# RAG_TEMPERATURE=0.1

# --- Retrieval guardrails ---
# RAG_MIN_RELEVANCE_SCORE=0.35
# RAG_TOP_K=5

# --- Evaluation ---
# RAG_EVAL_MIN_SCORE=0.85