# .env.example — Copy to .env and fill in your API keys.
# Required keys depend on which providers you configure.

# ROUTER_ANTHROPIC_API_KEY=sk-ant-...
# ROUTER_OPENAI_API_KEY=sk-proj-...
# ROUTER_OLLAMA_BASE_URL=http://localhost:11434
# ROUTER_OLLAMA_MODEL=llama3.2

# ROUTER_ANTHROPIC_TIMEOUT_S=30.0
# ROUTER_OPENAI_TIMEOUT_S=30.0
# ROUTER_OLLAMA_TIMEOUT_S=60.0

# ROUTER_MAX_RETRIES=3
# ROUTER_CACHE_TTL_S=300
# ROUTER_CACHE_MAX_SIZE=1000
# ROUTER_MAX_TOTAL_TOKENS_IN=1000000
# ROUTER_MAX_TOTAL_TOKENS_OUT=100000
# ROUTER_MAX_COST_USD=10.0